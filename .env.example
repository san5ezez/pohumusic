# ============================================================================
# POHUMUSIC — CLOUDFLARE WORKERS ENVIRONMENT & SECRETS (.env.example / .dev.vars)
# ============================================================================
# In production on Cloudflare Workers, set secrets using:
#   wrangler secret put JWT_ACCESS_SECRET
#   wrangler secret put JWT_REFRESH_SECRET
#   wrangler secret put SOUNDCLOUD_CLIENT_ID
#   wrangler secret put SOUNDCLOUD_CLIENT_SECRET
#   wrangler secret put YOUTUBE_API_KEY
#   wrangler secret put GOOGLE_CLIENT_ID
#   wrangler secret put GOOGLE_CLIENT_SECRET
#   wrangler secret put DISCORD_CLIENT_ID
#   wrangler secret put DISCORD_CLIENT_SECRET
#   wrangler secret put SMTP_API_KEY
#
# Storage Policy:
# - Cloudflare D1 (binding: DB) is used as the single source of truth for relational data.
# - Cloudflare KV (binding: KV) is used for provider response caching, OAuth state, and rate limiting.
# - Cloudflare R2 is STRICTLY PROHIBITED and never configured.
# - No audio files are stored or proxied on the server.
# ============================================================================

ENVIRONMENT="development"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,https://pohumusic.workers.dev"

# JWT & Session Cryptography
JWT_ACCESS_SECRET="replace-with-at-least-32-byte-cryptographic-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-byte-cryptographic-refresh-secret"
PASSWORD_PEPPER="replace-with-server-side-secret-pepper"

# SoundCloud Official API v2 / OAuth 2.1 Credentials
# Register at https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=""
SOUNDCLOUD_CLIENT_SECRET=""
SOUNDCLOUD_API_BASE_URL="https://api.soundcloud.com"
SOUNDCLOUD_TOKEN_URL="https://secure.soundcloud.com/oauth/token"

# YouTube Data API v3 Credentials
# Enable YouTube Data API v3 in Google Cloud Console
YOUTUBE_API_KEY=""
YOUTUBE_DAILY_QUOTA_LIMIT="10000"

# OAuth 2.0 Login Providers (Server-Side Only — Never Exposed to Client)
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="750365132799-2fg0f63sar4aqqppnru3l7e4e2d8cnrg.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"
GOOGLE_REDIRECT_URI="https://pohumusic-backend.4g-2551.workers.dev/api/v1/auth/oauth/google/callback"

# Discord Developer Portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID="1565970971511357440"
DISCORD_CLIENT_SECRET="Ynp4zTqs8Uy-wzyRnG9g3Q--0aJBKWQA"
DISCORD_REDIRECT_URI="https://pohumusic-backend.4g-2551.workers.dev/api/v1/auth/oauth/discord/callback"

# Transactional Email Service via Resend API
# Resend Dashboard: https://resend.com/api-keys
SMTP_PROVIDER="resend"
SMTP_API_KEY="re_GsYvXYrU_KbtQ8QgpYgZpsG2axmuQRmzC"
SMTP_FROM_EMAIL="onboarding@resend.dev"
